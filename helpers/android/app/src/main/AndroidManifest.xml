<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DevDeck">

        <activity
            android:name=".home.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.DevDeck.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- DevDeck sends the marker state here with an explicit adb broadcast (see helpers/README.md). -->
        <receiver
            android:name=".StateReceiver"
            android:exported="true" />

        <!-- Remembers that the user swiped the marker away (notification delete intent). -->
        <receiver
            android:name=".DismissReceiver"
            android:exported="false" />
    </application>
</manifest>
